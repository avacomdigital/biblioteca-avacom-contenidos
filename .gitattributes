# Fin de linea. Los guiones de consola de Windows dejan de funcionar si les
# llega un fin de linea de otro sistema, asi que se fijan explicitamente.
* text=auto

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.txt  text eol=crlf

*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.manifest text eol=crlf
*.appxmanifest text eol=crlf

*.py   text eol=lf
*.sql  text eol=lf
*.json text eol=lf

# Binarios: que no los toque nadie
*.png  binary
*.jpg  binary
*.mp4  binary
*.wav  binary
*.pdf  binary
*.zip  binary
*.enc  binary
*.sig  binary
*.db   binary

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Avacom.Contenido.Consola</RootNamespace>
    <AssemblyName>avacom</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Avacom.Contenido/Avacom.Contenido.csproj" />
  </ItemGroup>
</Project>

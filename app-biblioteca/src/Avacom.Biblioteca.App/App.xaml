<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vis="clr-namespace:Avacom.Biblioteca.App.Vistas"
             x:Class="Avacom.Biblioteca.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colores.xaml" />
        <ResourceDictionary Source="Resources/Styles/Estilos.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <vis:Negar x:Key="Negar" />
      <vis:HayTexto x:Key="HayTexto" />
      <vis:EsIgual x:Key="EsIgual" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
